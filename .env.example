# Anslutning till PostgreSQL. I Supabase: Project Settings → Database → Connection string (Transaction pooler, port 6543).
DATABASE_URL=postgres://user:password@host:5432/database

# Minst 32 slumpade tecken. Skapa t.ex. med: openssl rand -base64 48
SESSION_SECRET=

# Den publika adressen, utan / på slutet. Används i elevlänkar och QR-koder.
APP_URL=https://utbildning.exempel.se

# Hemlig nyckel för den dagliga gallringen. Vercel skickar den automatiskt om den heter CRON_SECRET.
CRON_SECRET=

# E-post (inbjudningar, glömt lösenord, inloggningslänkar för elever) via SMTP, t.ex. Broadview.
# Utan SMTP_HOST visas inbjudningslänkar i admin för att skickas manuellt.
SMTP_HOST=
# 465 = SSL, 587 = STARTTLS
SMTP_PORT=465
SMTP_USER=noreply@briondo.se
SMTP_PASS=
MAIL_FROM=Briondo <noreply@briondo.se>
# Dit går svar på mejlen (valfritt)
MAIL_REPLY_TO=
# Lokalt/test: spara mejl som filer i stället för att skicka (lämna tomt i drift)
# MAIL_DIR=tests/out/mail

# Speakerröst per avsnitt (ljudfilerna ligger i Supabase Storage, bucketen avsnittsljud).
# I Supabase: Project Settings → Data API → Project URL, t.ex. https://abcdefgh.supabase.co
SUPABASE_URL=
# I Supabase: Project Settings → API Keys → secret key (sb_secret_…) eller den äldre service_role-nyckeln.
# Hemlig – bara på servern, aldrig i en NEXT_PUBLIC_-variabel.
SUPABASE_SERVICE_ROLE_KEY=
